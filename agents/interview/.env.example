# LiveKit Cloud project (same values as the Next.js app's .env.local)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# OpenAI Realtime (the interview conversation engine)
OPENAI_API_KEY=
# OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_REALTIME_VOICE=marin

# Where the Next.js app runs — the worker POSTs transcript turns here
SCREENR_APP_ORIGIN=http://localhost:3000
# Must equal AGENT_API_SECRET in the app's .env.local
AGENT_API_SECRET=

# Vision proctoring (Phase C2) — optional, both have defaults.
# VISION_SAMPLE_INTERVAL_MS: how often a camera frame is analysed (default 10000).
#   This is the cost dial: ~2,980 prompt tokens per frame on gpt-4o-mini, so a
#   10-minute interview at 10s is roughly $0.03. Raising it costs less and
#   detects less; the rule thresholds are in milliseconds so they stay correct.
#   On a call this short there is little room to widen it before the evidence
#   thins out — ~60 samples is the whole basis for the proctoring report.
# VISION_MODEL: vision-capable model used to count people (default gpt-4o-mini).
VISION_SAMPLE_INTERVAL_MS=10000
VISION_MODEL=gpt-4o-mini
