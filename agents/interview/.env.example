# LiveKit Cloud project (same values as the Next.js app's .env.local)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# OpenAI Realtime (the interview conversation engine)
OPENAI_API_KEY=
# OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_REALTIME_VOICE=marin

# Where the Next.js app runs. REQUIRED — not optional any more: the worker
# fetches its interviewer instructions from here on every job (they used to
# ride LiveKit room metadata, which the candidate's browser can read) and posts
# transcript turns, proctoring readings and evidence stills back. Without it the worker has nothing to say and leaves the
# candidate in a silent room.
SCREENR_APP_ORIGIN=http://localhost:3000
# Must equal AGENT_API_SECRET in the app's .env.local
AGENT_API_SECRET=

# Vision proctoring (Phase C2) — all optional, all have defaults.
# Detection runs LOCALLY on the committed YOLOX model (models/yolox_tiny.onnx),
# so there is no per-frame cost and no API key: frames are scored in memory and
# discarded. The interview is not recorded and no image is ever stored.
#
# VISION_SAMPLE_INTERVAL_MS: how often a reading is KEPT for the report
#   (default 5000). Not how often a frame is analysed — the overlay already
#   scores one every second; this is the RESOLUTION of the stored evidence.
#   An incident's duration is measured first flagged sample to last, so this
#   rounds every finding down to a multiple of itself: at 10000 a phone in view
#   for 18s measured 10s, fell under the 15s bar, and was thrown away with its
#   snapshot. Raising it back hides short findings; lowering it costs schema
#   headroom (a report is capped at 500 observations).
# VISION_MODEL_PATH: absolute path to alternate ONNX weights (default: the
#   committed models/yolox_tiny.onnx — see models/README.md before swapping).
# VISION_INFERENCE_THREADS: intra-op threads for the detector (default 2).
#   Inference runs on its own worker thread — onnxruntime's run() is a
#   synchronous native call, so running it inline would block the same event
#   loop that pumps Realtime audio. Off that loop, more threads is simply
#   faster with nothing to trade against.
# VISION_DETECTION_MIN_SCORE: override the class score floors, 0–1. Unset uses
#   the tuned defaults in src/postprocess.ts (candidate 0.35, phone 0.45, and a
#   stricter 0.6 for any SECOND person). It reaches the decode floor too, so a
#   value under 0.2 now genuinely takes effect — it used to be swallowed by a
#   filter that ran in front of it.
#   One asymmetry it cannot cross: this can only ever RAISE the floor for an
#   extra person, never lower it. "Detect more" honestly means "find the
#   candidate more easily"; an env var must not be able to quietly make the
#   product readier to report someone else in the room, which is a finding
#   nobody can check because the interview is not recorded.
VISION_SAMPLE_INTERVAL_MS=5000
# VISION_MODEL_PATH=
# VISION_DETECTION_MIN_SCORE=

# Live overlay — draws detection boxes on the CANDIDATE's own self-view during
# the interview. On by default; set VISION_OVERLAY=0 to turn it off.
#
# Note what this trades away: the candidate can see what was detected and when,
# so they can time around it. The report is unaffected (boxes flow worker →
# browser only, and the reporting route rejects anything the browser sends), but
# the element of not tipping them off is gone.
#
# VISION_OVERLAY_INTERVAL_MS: how often frames are scored while the overlay is
#   on (default 1000). Independent of the report cadence above — the report is
#   still recorded every VISION_SAMPLE_INTERVAL_MS, so stored evidence does not
#   change with this. It is purely a CPU-vs-smoothness dial: ~75ms per frame, so
#   1s ≈ 7% of a core per concurrent interview against 0.7% at 10s.
# VISION_OVERLAY=0
# VISION_OVERLAY_INTERVAL_MS=1000

# Evidence snapshots — when a frame is flagged (second person, nobody, phone),
# the worker encodes that ONE frame as a small annotated JPEG and posts it to
# the app, which stores it in a private bucket. It exists because the interview
# is not recorded: without it a recruiter has no way to check an automated
# finding. A clean interview stores no image at all, and anything not inside a
# CONFIRMED incident is deleted when the report is finalized.
#
# VISION_SNAPSHOTS=0 disables capture entirely.
# VISION_SNAPSHOT_INTERVAL_MS: minimum gap between stills of the SAME condition
#   (default 15000). A phone on the desk for five minutes is one finding, not
#   three hundred photographs of a candidate. Halved when the incident bar
#   dropped to 5s: an image only attaches if a still falls inside the incident's
#   window, so too wide a gap leaves a brief finding with no picture. Costs
#   uploads, not stored images — all but one still per incident is deleted at
#   submit.
# VISION_SNAPSHOTS=0
# VISION_SNAPSHOT_INTERVAL_MS=15000
