{
  "name": "screenr-interview-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LiveKit agent worker that runs the Screenr AI video interview (OpenAI Realtime) and reports the transcript back to the app.",
  "scripts": {
    "dev": "tsx src/agent.ts dev",
    "start": "tsx src/agent.ts start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@livekit/local-inference",
      "esbuild",
      "onnxruntime-node",
      "protobufjs",
      "sharp"
    ]
  },
  "dependencies": {
    "@livekit/agents": "^1.0.0",
    "@livekit/agents-plugin-openai": "^1.0.0",
    "@livekit/rtc-node": "^0.13.33",
    "dotenv": "^16.4.5",
    "onnxruntime-node": "^1.27.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
