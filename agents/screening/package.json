{
  "name": "screenr-screening-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LiveKit agent worker that runs the Screenr AI voice screening interview (OpenAI Realtime) and reports the transcript back to the app.",
  "scripts": {
    "dev": "tsx src/agent.ts dev",
    "start": "tsx src/agent.ts start",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@livekit/local-inference",
      "esbuild",
      "protobufjs",
      "sharp"
    ]
  },
  "dependencies": {
    "@livekit/agents": "^1.0.0",
    "@livekit/agents-plugin-openai": "^1.0.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
