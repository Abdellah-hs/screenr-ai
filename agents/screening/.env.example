# LiveKit Cloud project (same values as the Next.js app's .env.local)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# OpenAI Realtime (the interview conversation engine)
OPENAI_API_KEY=
# OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_REALTIME_VOICE=marin
# The sidecar that produces the TRANSCRIPT. Realtime is speech-to-speech, so
# the interviewer never reads this text — when it fails the call sounds normal
# and the durable record is empty, which scores every rubric dimension 0. Its
# language is pinned from the candidate's own choice, not auto-detected.
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Where the Next.js app runs. REQUIRED — not optional any more: the worker
# fetches its interviewer instructions from here on every job (they used to
# ride LiveKit room metadata, which the candidate's browser can read) and posts
# transcript turns back. Without it the worker has nothing to say and leaves the
# candidate in a silent room.
SCREENR_APP_ORIGIN=http://localhost:3000
# Must equal AGENT_API_SECRET in the app's .env.local
AGENT_API_SECRET=

# Runtime topic control — the app decides which question comes next; the worker
# says it and times the answer. There is no switch to turn this off: an
# unreachable app ends the call with a short technical message rather than
# letting the interviewer invent its own questions.
#
# How long to wait on a control call before failing (ms). The interviewer is
# mid-conversation, so this is short on purpose.
# SCREENING_CONTROL_TIMEOUT_MS=6000
# How long to wait on a fire-and-forget report (ms). turn_completed runs the
# turn evaluator, so this covers an OpenAI round-trip and nothing is waiting.
# SCREENING_REPORT_TIMEOUT_MS=25000

# How patient the interviewer is with a pause.
#
# A candidate thinking mid-answer is the normal shape of a good answer, and both
# of these exist because ending their turn on that pause spends the topic on
# half of it.
#
# How long the DETECTOR waits before calling a pause the end of a turn:
# auto | low | medium | high. Defaults to low — an interview answer is not chat.
# SCREENING_VAD_EAGERNESS=low
# How long the WORKER then sits on that verdict before reporting the answer and
# asking the next question (ms, max 10000). If they start again inside it, the
# fragments are one answer and nothing was spent. 0 switches the hold off.
#
# The reply to the AUDIO CHECK is held for at most a second whatever this says:
# "can you hear me?" is answered in one word, so a longer hold there is only
# dead air at the top of the call. Setting this to 0 switches that off too.
#
# A turn of fewer than SUBSTANTIAL_ANSWER_WORDS words is NOT settled on a pause
# at all: three words and a pause is somebody thinking, not somebody finished,
# and settling there spends their topic with most of their minute still on
# screen. Their countdown carries it instead, and the "I'm done" button in the
# candidate's browser is how anyone who has finished skips the wait.
# SCREENING_ANSWER_SETTLE_MS=3000
